---
import { Icon } from "astro-icon/components";
const { class: className = "" } = Astro.props;
---

<button
  class:list={["btn btn-square btn-ghost theme-toggle", className]}
  aria-label="Toggle theme"
>
  <Icon name="carbon:sun" class="hidden text-3xl theme-icon-sun" />
  <Icon name="carbon:moon" class="hidden text-3xl theme-icon-moon" />
</button>

<script>
  function applyThemeIcons() {
    const theme = document.documentElement.getAttribute("data-theme");
    document.querySelectorAll(".theme-icon-sun").forEach((el) => {
      el.classList.toggle("hidden", theme !== "night");
    });
    document.querySelectorAll(".theme-icon-moon").forEach((el) => {
      el.classList.toggle("hidden", theme === "night");
    });
  }
  applyThemeIcons();

  document.querySelectorAll(".theme-toggle").forEach((btn) => {
    btn.addEventListener("click", () => {
      const current = document.documentElement.getAttribute("data-theme");
      const next = current === "night" ? "winter" : "night";
      document.documentElement.setAttribute("data-theme", next);
      localStorage.setItem("theme", next);
      applyThemeIcons();
    });
  });
</script>
