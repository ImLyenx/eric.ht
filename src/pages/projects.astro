---
import MainLayout from "@/layouts/MainLayout.astro";
import { getCollection } from "astro:content";
const projectsEntries = await getCollection("projects");
import { Icon } from "astro-icon/components";
---

<MainLayout title="Projects">
  <div class="-z-10 mx-auto md:z-0">
    <div class="mb-8 pt-8">
      <h1 class="text-4xl font-extrabold">My Projects</h1>
    </div>
    <div class="grid gap-8 md:grid-cols-[repeat(2,1fr)]">
      {
        projectsEntries.map((entry) => (
          <div class="flex w-full rounded-box bg-base-100 shadow-2xl transition-all hover:-translate-y-1">
            <div class="flex flex-1 flex-col gap-2 p-6">
              <div class="flex justify-between">
                <h2 class="flex items-center gap-2 text-lg font-semibold">
                  <a
                    class="font-extrabold underline underline-offset-4"
                    href={`/projects/${entry.id}`}
                  >
                    {entry.data.title}
                  </a>
                </h2>
                <div class="flex min-w-[100px] flex-wrap items-start justify-end gap-2">
                  {entry.data.github ? (
                    <div
                      class="tooltip"
                      data-tip="View on GitHub"
                    >
                      <a
                        href={"https://github.com/" + entry.data.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-ghost btn-sm"
                      >
                        <Icon name="carbon:logo-github" class="text-xl" />
                      </a>
                    </div>
                  ) : (
                    <div
                      class="tooltip tooltip-error cursor-not-allowed"
                      data-tip="This project is closed-source"
                    >
                      <span class="btn btn-disabled btn-sm">
                        <Icon name="carbon:logo-github" class="text-xl" />
                      </span>
                    </div>
                  )}
                  {entry.data.demo ? (
                    <div
                      class="tooltip"
                      data-tip="Check it out!"
                    >
                      <a
                        href={entry.data.demo}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-ghost btn-sm"
                      >
                        <Icon name="carbon:link" class="text-xl" />
                      </a>
                    </div>
                  ) : (
                    <div
                      class="tooltip tooltip-error cursor-not-allowed"
                      data-tip="No demo available"
                    >
                      <span class="btn btn-disabled btn-sm">
                        <Icon name="carbon:link" class="text-xl" />
                      </span>
                    </div>
                  )}
                </div>
              </div>
              <div>
                {entry.data.tags.map((tag) => (
                  <div
                    class="m-1 inline-flex h-6 items-center rounded-md border px-2 text-sm font-semibold tracking-wide"
                    style={
                      "color:" +
                      tag.color +
                      "; background-color:" +
                      tag.color +
                      "30" +
                      "; border-color:" +
                      tag.color +
                      "30;"
                    }
                  >
                    <Icon name={tag.icon} class="mr-2" />
                    {tag.name}
                  </div>
                ))}
              </div>
              <div class="my-1.5 h-px bg-base-content/10" />
              <p>{entry.data.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</MainLayout>
