---
import MainLayout from "@/layouts/MainLayout.astro";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import logo from "@/assets/logo.svg";
---

<MainLayout title="">
  <div class="flex max-w-5xl flex-col pt-8 text-2xl md:pt-32 gap-4">
    <p class="text-lg flex flex-wrap items-center">
      Hey, I'm Eric, a software engineer based near Paris, France.
    </p>
    <p class="text-lg flex flex-wrap items-center">
      I mostly do backend work, so if you notice what I'm doing, something
      probably went wrong.
    </p>

    <p class="text-lg flex flex-wrap items-center">
      Currently working on emails and domains at Scaleway. In my spare time, I'm
      building ParisGuessr, a collection of minigames about the Paris transport
      network.
    </p>
    <p class="text-lg flex flex-wrap items-center">
      I like tinkering with electronics and designing PCBs. I also enjoy doing
      hackathons with my friends, most recently at SNCF Voyageurs on the new TGV M.
    </p>
    <p class="text-lg">You can send me an email at <a href="mailto:hey@eric.ht" class="underline underline-offset-2">hey@eric.ht</a>, and find me on <a href="https://github.com/ImLyenx" class="underline underline-offset-2">GitHub</a> and <a href="https://linkedin.com/in/huberic" class="underline underline-offset-2">LinkedIn</a>.</p>
    <Image src={logo} alt="EH logo" class="mt-4 w-24" />
  </div>
</MainLayout>
