---
import MainHead from "@/components/MainHead.astro";

import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Where the "go back" link goes. Defaults to the homepage; hidden on it. */
  back?: string;
}

const { title, description, back = "/" } = Astro.props;
const isHome = Astro.url.pathname === "/";
---

<html lang="en">
  <head>
    <MainHead title={title} description={description} />
  </head>
  <body class="mx-6 flex min-h-screen flex-col items-center">
    <div
      class:list={[
        "w-full max-w-5xl flex-grow pt-8 pb-16",
        isHome ? "md:pt-32" : "md:pt-16",
      ]}
    >
      {
        !isHome && (
          <nav class="mb-4 text-lg">
            <a href={back} class="underline underline-offset-2">
              go back
            </a>
          </nav>
        )
      }
      <main class="motion-safe:animate-content-fade">
        <slot />
      </main>
    </div>
  </body>
</html>
